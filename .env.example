# Copy to .env and fill in. Never commit the real .env.

# Required. Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Admin account created on first boot only. Leave ADMIN_PASSWORD empty to have
# a strong one-time password generated and printed in the container log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

PORT=4040
DATA_DIR=/usr/src/app/data

# Hours before an end-user session expires.
SESSION_TTL_HOURS=24

# "auto" marks the session cookie Secure whenever the request arrived over TLS.
SECURE_COOKIES=auto

# Number of reverse proxy hops to trust for client IP and protocol detection.
TRUST_PROXY=1

MIN_PASSWORD_LENGTH=8
BCRYPT_ROUNDS=10

# Per-IP failed sign-in limits, over a sliding window.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_ADMIN_MAX=8
RATE_LIMIT_USER_MAX=10
