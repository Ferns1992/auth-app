<%- include('../partials/head', { title: 'Manage Users', active: 'users' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
  <div>
    <h3 class="mb-1">End Users</h3>
    <p class="text-dim mb-0">Accounts that can sign in to your apps, and which apps each one may reach.</p>
  </div>
  <span class="badge badge-neutral"><%= users.length %> user<%= users.length === 1 ? '' : 's' %> · <%= apps.length %> app<%= apps.length === 1 ? '' : 's' %></span>
</div>

<div class="row g-3">
  <div class="col-lg-4">
    <div class="glass-card p-4">
      <h5 class="mb-3"><i class="bi bi-person-plus"></i> Add New User</h5>
      <form method="POST" action="/admin/users" autocomplete="off">
        <div class="mb-3">
          <label class="form-label">Username</label>
          <input type="text" name="username" class="form-control" required
                 pattern="[A-Za-z0-9._\-]+" maxlength="64" placeholder="jsmith">
          <div class="form-hint mt-1">Letters, numbers, dot, underscore, hyphen.</div>
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" required
                 minlength="<%= minPasswordLength %>" autocomplete="new-password">
          <div class="form-hint mt-1">At least <%= minPasswordLength %> characters.</div>
        </div>
        <button type="submit" class="btn btn-primary w-100">Create User</button>
      </form>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="glass-card p-4">
      <h5 class="mb-3"><i class="bi bi-people"></i> Existing Users</h5>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr>
              <th>Username</th>
              <th>App Access</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (users.length === 0) { %>
              <tr>
                <td colspan="3">
                  <div class="empty-state">
                    <div class="icon">👥</div>
                    <div>No end users yet. Create one to get started.</div>
                  </div>
                </td>
              </tr>
            <% } %>
            <% users.forEach(function (user) { %>
              <% var userAppIds = userApps.filter(function (ua) { return ua.user_id === user.id; }).map(function (ua) { return ua.app_id; }); %>
              <tr>
                <td>
                  <div class="fw-semibold"><%= user.username %></div>
                  <div class="small text-dim">created <span class="relative-time" data-time="<%= user.created_at %>"></span></div>
                </td>
                <td>
                  <% if (apps.length === 0) { %>
                    <span class="text-dim small">No apps registered yet</span>
                  <% } %>
                  <% apps.forEach(function (app) { %>
                    <% if (userAppIds.indexOf(app.id) !== -1) { %>
                      <form method="POST" action="/admin/revoke-app" class="d-inline" onsubmit="return confirm('Revoke <%= app.name %> access for <%= user.username %>?')">
                        <input type="hidden" name="user_id" value="<%= user.id %>">
                        <input type="hidden" name="app_id" value="<%= app.id %>">
                        <button type="submit" class="badge grant-pill border-0 me-1 mb-1" title="Click to revoke access">
                          <%= app.name %> ✕
                        </button>
                      </form>
                    <% } %>
                  <% }) %>
                  <% if (apps.length > 0) { %>
                    <select class="form-select form-select-sm d-inline-block mb-1" style="width:auto;"
                            onchange="assignApp(<%= user.id %>, this)">
                      <option value="">+ Assign app</option>
                      <% apps.forEach(function (app) { %>
                        <% if (userAppIds.indexOf(app.id) === -1) { %>
                          <option value="<%= app.id %>"><%= app.name %></option>
                        <% } %>
                      <% }) %>
                    </select>
                  <% } %>
                </td>
                <td class="text-end">
                  <form method="POST" action="/admin/users/<%= user.id %>/delete" class="d-inline"
                        onsubmit="return confirm('Delete <%= user.username %>? Their app access is removed too.')">
                    <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  function assignApp(userId, selectElem) {
    var appId = selectElem.value;
    if (!appId) return;
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '/admin/assign-app';
    [['user_id', userId], ['app_id', appId]].forEach(function (pair) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = pair[0];
      input.value = pair[1];
      form.appendChild(input);
    });
    document.body.appendChild(form);
    form.submit();
  }
</script>

<%- include('../partials/foot') %>
