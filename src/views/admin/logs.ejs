<%- include('../partials/head', { title: 'Auth Logs', active: 'logs' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
  <div>
    <h3 class="mb-1">Authentication Logs</h3>
    <p class="text-dim mb-0">Every sign-in attempt, admin login, and access decision.</p>
  </div>
  <a href="/admin/logs.csv" class="btn btn-outline-light btn-sm"><i class="bi bi-download"></i> Export CSV</a>
</div>

<div class="glass-card p-3 mb-3">
  <div class="row g-2 align-items-center">
    <div class="col-lg-6">
      <input type="search" id="logSearch" class="form-control" placeholder="Search user, app, IP or event…">
    </div>
    <div class="col-lg-6">
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="filter-chip active" data-filter="all">All</span>
        <span class="filter-chip" data-filter="success">Success</span>
        <span class="filter-chip" data-filter="failed">Failed</span>
        <span class="ms-auto small text-dim" id="logCount"></span>
      </div>
    </div>
  </div>
</div>

<div class="glass-card p-0">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" id="logTable">
      <thead>
        <tr>
          <th>When</th>
          <th>User</th>
          <th>App</th>
          <th>Event</th>
          <th>IP Address</th>
          <th>Result</th>
        </tr>
      </thead>
      <tbody>
        <% if (logs.length === 0) { %>
          <tr>
            <td colspan="6">
              <div class="empty-state">
                <div class="icon">📋</div>
                <div>No authentication attempts recorded yet.</div>
              </div>
            </td>
          </tr>
        <% } %>
        <% logs.forEach(function (log) { %>
          <tr data-success="<%= log.success ? 'success' : 'failed' %>"
              data-search="<%= [log.username, log.app_name, log.ip_address, log.event, log.user_agent].filter(Boolean).join(' ').toLowerCase().replace(/"/g, '') %>">
            <td class="text-nowrap">
              <span class="relative-time" data-time="<%= log.timestamp %>"></span>
            </td>
            <td><%= log.username || '—' %></td>
            <td><%= log.app_name || '—' %></td>
            <td><span class="badge badge-neutral"><%= log.event %></span></td>
            <td class="mono text-dim"><%= log.ip_address || '—' %></td>
            <td>
              <span class="badge <%= log.success ? 'badge-ok' : 'badge-bad' %>">
                <%= log.success ? '✓ Success' : '✗ Failed' %>
              </span>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
  (function () {
    var search = document.getElementById('logSearch');
    var chips = Array.prototype.slice.call(document.querySelectorAll('.filter-chip'));
    var rows = Array.prototype.slice.call(document.querySelectorAll('#logTable tbody tr[data-success]'));
    var counter = document.getElementById('logCount');
    var active = 'all';

    function apply() {
      var term = (search.value || '').trim().toLowerCase();
      var shown = 0;
      rows.forEach(function (row) {
        var okFilter = active === 'all' || row.getAttribute('data-success') === active;
        var okSearch = !term || (row.getAttribute('data-search') || '').indexOf(term) !== -1;
        var visible = okFilter && okSearch;
        row.style.display = visible ? '' : 'none';
        if (visible) shown++;
      });
      counter.textContent = shown + ' of ' + rows.length + ' shown';
    }

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        chips.forEach(function (c) { c.classList.remove('active'); });
        chip.classList.add('active');
        active = chip.getAttribute('data-filter');
        apply();
      });
    });

    search.addEventListener('input', apply);
    apply();
  })();
</script>

<%- include('../partials/foot') %>
