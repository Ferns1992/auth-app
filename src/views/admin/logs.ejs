<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Auth Logs - Auth Gateway</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { font-family: 'Inter', sans-serif; }
    body { background: #0f0f1a; color: #e2e8f0; min-height: 100vh; }
    .navbar { background: rgba(15, 15, 26, 0.95) !important; backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
    .navbar-brand { font-weight: 700; font-size: 1.3rem; }
    .glass-card {
      background: rgba(255, 255, 255, 0.03);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 16px;
    }
    .btn-outline-light { border-radius: 10px; font-size: 0.85rem; }
    .table { color: #e2e8f0; }
    .table-striped > tbody > tr:nth-of-type(odd) > * { background: rgba(255, 255, 255, 0.02); color: #e2e8f0; }
    .table td, .table th { border-color: rgba(255, 255, 255, 0.05); vertical-align: middle; }
    .badge { border-radius: 8px; padding: 6px 12px; font-weight: 500; }
    .text-muted { color: #64748b !important; }
    .text-break { color: #94a3b8; font-size: 0.8rem; }
    h3, h5 { font-weight: 600; color: #f1f5f9; }
    small { font-size: 0.85rem; }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
      <a class="navbar-brand" href="/admin/dashboard">🔐 Auth Gateway</a>
      <div class="d-flex gap-2">
        <a href="/admin/dashboard" class="btn btn-outline-light btn-sm">Dashboard</a>
        <a href="/admin/logout" class="btn btn-outline-light btn-sm">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <h3>📋 Authentication Logs</h3>
    <p class="text-muted">All authentication attempts with links used, IP addresses, and status</p>

    <div class="glass-card p-4">
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Timestamp</th>
              <th>User</th>
              <th>App</th>
              <th>Auth Link Used</th>
              <th>IP Address</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% logs.forEach(log => { %>
              <tr>
                <td><small><%= new Date(log.timestamp).toLocaleString() %></small></td>
                <td><%= log.username || 'Unknown' %></td>
                <td><%= log.app_name || 'Unknown' %></td>
                <td><small class="text-break"><%= log.redirect_uri || 'N/A' %></small></td>
                <td><small><%= log.ip_address %></small></td>
                <td>
                  <span class="badge bg-<%= log.success ? 'success' : 'danger' %>">
                    <%= log.success ? '✓ Success' : '✗ Failed' %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>