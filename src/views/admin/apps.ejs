<%- include('../partials/head', { title: 'Manage Apps', active: 'apps' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
  <div>
    <h3 class="mb-1">Registered Apps</h3>
    <p class="text-dim mb-0">Each app gets a client id, a client secret, and exactly one allowed redirect URI.</p>
  </div>
  <span class="badge badge-neutral"><%= apps.length %> app<%= apps.length === 1 ? '' : 's' %></span>
</div>

<div class="row g-3">
  <div class="col-lg-4">
    <div class="glass-card p-4 mb-3">
      <h5 class="mb-3"><i class="bi bi-plus-circle"></i> Register New App</h5>
      <form method="POST" action="/admin/apps" autocomplete="off">
        <div class="mb-3">
          <label class="form-label">App Name</label>
          <input type="text" name="name" class="form-control" required maxlength="64" placeholder="My App">
        </div>
        <div class="mb-3">
          <label class="form-label">Redirect URI</label>
          <input type="url" name="redirect_uri" class="form-control" required
                 placeholder="https://app.com/callback">
          <div class="form-hint mt-1">Must match exactly. Any other value is rejected at sign-in.</div>
        </div>
        <button type="submit" class="btn btn-primary w-100">Register App</button>
      </form>
    </div>

    <div class="glass-card p-4">
      <h5 class="mb-3"><i class="bi bi-globe"></i> Base URL</h5>
      <p class="form-hint mb-3">Used to build the sign-in links below.</p>
      <form method="POST" action="/admin/settings/base-url" autocomplete="off">
        <div class="mb-3">
          <label class="form-label">Custom Domain</label>
          <input type="url" name="base_url" class="form-control" placeholder="https://auth.example.com" value="<%= baseUrl %>">
        </div>
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Save</button>
          <button type="button" class="btn btn-outline-light btn-sm" onclick="copyText('<%= baseUrl %>', 'Base URL')">Copy</button>
        </div>
      </form>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="glass-card p-0">
      <div class="p-3 border-bottom" style="border-color:rgba(255,255,255,0.05)!important;">
        <h5 class="mb-0"><i class="bi bi-collection"></i> Your Apps</h5>
      </div>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>App</th>
              <th>Client Secret</th>
              <th>Redirect URI</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (apps.length === 0) { %>
              <tr>
                <td colspan="4">
                  <div class="empty-state">
                    <div class="icon">📱</div>
                    <div>No apps registered yet. Add one to start gating access.</div>
                  </div>
                </td>
              </tr>
            <% } %>
            <% apps.forEach(function (app) { %>
              <% var link = baseUrl + '/auth/authorize?client_id=' + encodeURIComponent(app.client_id) + '&redirect_uri=' + encodeURIComponent(app.redirect_uri); %>
              <tr>
                <td>
                  <div class="fw-semibold"><%= app.name %></div>
                  <div class="mono text-dim" id="cid-<%= app.id %>" data-value="<%= app.client_id %>">
                    <%= app.client_id %>
                  </div>
                </td>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <span class="mono" id="secret-<%= app.id %>" data-value="<%= app.client_secret %>">••••••••••••••••</span>
                    <button type="button" class="btn btn-sm btn-outline-light" title="Reveal"
                            onclick="toggleSecret('<%= app.id %>', this)">
                      <i class="bi bi-eye"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light" title="Copy"
                            onclick="copyFromEl('secret-<%= app.id %>', 'Client secret')">
                      <i class="bi bi-clipboard"></i>
                    </button>
                  </div>
                </td>
                <td>
                  <span class="mono text-dim d-block truncate" title="<%= app.redirect_uri %>"><%= app.redirect_uri %></span>
                </td>
                <td class="text-end text-nowrap">
                  <button type="button" class="btn btn-sm btn-outline-light" title="Copy sign-in link"
                          onclick="copyText('<%= link %>', 'Sign-in link')">
                    <i class="bi bi-link-45deg"></i>
                  </button>
                  <form method="POST" action="/admin/apps/<%= app.id %>/regenerate-secret" class="d-inline"
                        onsubmit="return confirm('Rotate the client secret for <%= app.name %>? Anything storing the old secret must be updated.')">
                    <button type="submit" class="btn btn-sm btn-outline-light" title="Rotate client secret">
                      <i class="bi bi-arrow-clockwise"></i>
                    </button>
                  </form>
                  <form method="POST" action="/admin/apps/<%= app.id %>/delete" class="d-inline"
                        onsubmit="return confirm('Delete <%= app.name %>? Users lose access immediately.')">
                    <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleSecret(id, btn) {
    var el = document.getElementById('secret-' + id);
    if (!el) return;
    var hidden = el.textContent.indexOf('•') === 0;
    el.textContent = hidden ? el.dataset.value : '••••••••••••••••';
    btn.innerHTML = hidden ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
  }
</script>

<%- include('../partials/foot') %>
