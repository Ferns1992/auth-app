<%- include('../partials/head', { title: 'Dashboard', active: 'dashboard' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
  <div>
    <h3 class="mb-1">Dashboard</h3>
    <p class="text-dim mb-0">Access control overview for every app behind this gateway.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/apps" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Register App</a>
    <a href="/admin/users" class="btn btn-outline-light btn-sm"><i class="bi bi-person-plus"></i> Add User</a>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-6 col-lg-3">
    <div class="glass-card stat-card p-3 h-100">
      <div class="stat-label">End Users</div>
      <div class="stat-number"><%= userCount %></div>
      <a href="/admin/users" class="small text-decoration-none">Manage <i class="bi bi-arrow-right"></i></a>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="glass-card stat-card ok p-3 h-100">
      <div class="stat-label">Registered Apps</div>
      <div class="stat-number"><%= appCount %></div>
      <a href="/admin/apps" class="small text-decoration-none">Manage <i class="bi bi-arrow-right"></i></a>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="glass-card stat-card <%= successRate === null || successRate >= 90 ? 'ok' : 'warn' %> p-3 h-100">
      <div class="stat-label">Success Rate</div>
      <div class="stat-number"><%= successRate === null ? '—' : successRate + '%' %></div>
      <div class="small text-dim"><%= successCount %> of <%= successCount + failCount %> attempts</div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="glass-card stat-card <%= failures24h > 0 ? 'bad' : '' %> p-3 h-100">
      <div class="stat-label">Failed (24h)</div>
      <div class="stat-number"><%= failures24h %></div>
      <div class="small text-dim"><%= attempts24h %> attempts in 24h</div>
    </div>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-6 col-lg-3">
    <div class="glass-card p-3 h-100">
      <div class="stat-label">Total Attempts</div>
      <div class="stat-number" style="font-size:1.5rem;"><%= logCount %></div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="glass-card p-3 h-100">
      <div class="stat-label">Successful</div>
      <div class="stat-number" style="font-size:1.5rem;color:#6ee7b7;"><%= successCount %></div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="glass-card p-3 h-100">
      <div class="stat-label">Failed</div>
      <div class="stat-number" style="font-size:1.5rem;color:#fca5a5;"><%= failCount %></div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="glass-card p-3 h-100">
      <div class="stat-label">Active Sessions</div>
      <div class="stat-number" style="font-size:1.5rem;">24h</div>
      <div class="small text-dim">rolling window</div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-4">
    <div class="glass-card p-4 h-100">
      <h5 class="mb-3"><i class="bi bi-bar-chart"></i> Most Used Apps</h5>
      <% if (!topApps || topApps.length === 0) { %>
        <div class="empty-state">
          <div class="icon">📊</div>
          <div>No authentication traffic yet.</div>
        </div>
      <% } else { %>
        <% topApps.forEach(function (app) { %>
          <div class="d-flex justify-content-between align-items-center py-2">
            <span class="text-truncate pe-2"><%= app.name %></span>
            <span class="badge badge-accent"><%= app.uses %></span>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="glass-card p-4 h-100">
      <h5 class="mb-3"><i class="bi bi-clock-history"></i> Recent Attempts</h5>
      <% if (!recentLogs || recentLogs.length === 0) { %>
        <div class="empty-state">
          <div class="icon">🕒</div>
          <div>Nothing has hit the gateway yet.</div>
        </div>
      <% } else { %>
        <div style="max-height:320px;overflow-y:auto;">
          <% recentLogs.forEach(function (log) { %>
            <div class="d-flex align-items-center gap-2 py-2 border-bottom" style="border-color:rgba(255,255,255,0.05)!important;">
              <span class="badge <%= log.success ? 'badge-ok' : 'badge-bad' %>"><%= log.success ? '✓' : '✗' %></span>
              <div class="flex-grow-1" style="min-width:0;">
                <div class="text-truncate"><%= log.username || 'unknown' %></div>
                <div class="small text-dim text-truncate"><%= log.app_name || (log.event === 'admin_login' ? 'admin login' : 'gateway') %></div>
              </div>
              <span class="relative-time small text-dim text-nowrap" data-time="<%= log.timestamp %>"></span>
            </div>
          <% }) %>
        </div>
        <a href="/admin/logs" class="btn btn-outline-light btn-sm w-100 mt-3">View all logs</a>
      <% } %>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="glass-card p-4 h-100">
      <h5 class="mb-3"><i class="bi bi-shield-lock"></i> Change Admin Password</h5>
      <form method="POST" action="/admin/change-password" autocomplete="off">
        <div class="mb-3">
          <label class="form-label">Current Password</label>
          <input type="password" name="currentPassword" class="form-control" required autocomplete="current-password">
        </div>
        <div class="mb-3">
          <label class="form-label">New Password</label>
          <input type="password" name="newPassword" class="form-control" required minlength="<%= minPasswordLength %>" autocomplete="new-password">
          <div class="form-hint mt-1">At least <%= minPasswordLength %> characters.</div>
        </div>
        <div class="mb-3">
          <label class="form-label">Confirm New Password</label>
          <input type="password" name="confirmPassword" class="form-control" required minlength="<%= minPasswordLength %>" autocomplete="new-password">
        </div>
        <button type="submit" class="btn btn-primary w-100">Update Password</button>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
