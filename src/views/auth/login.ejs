<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign in - Auth Gateway</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { font-family: 'Inter', sans-serif; }
    body {
      background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
      min-height: 100vh; display: flex; align-items: center; margin: 0;
    }
    .glass-card {
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
      animation: fadeIn 0.6s ease-in;
    }
    .form-control {
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: white; border-radius: 12px; padding: 12px 16px;
      transition: all 0.3s ease;
    }
    .form-control:focus {
      background: rgba(255, 255, 255, 0.1); border-color: #6366f1; color: white;
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
    }
    .form-control::placeholder { color: rgba(255, 255, 255, 0.4); }
    .btn-primary {
      background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
      border: none; border-radius: 12px; padding: 12px;
      font-weight: 600; letter-spacing: 0.5px; transition: all 0.3s ease;
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4); }
    .alert-danger {
      background: rgba(239, 68, 68, 0.2); border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5; border-radius: 12px;
    }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    .text-muted { color: rgba(255, 255, 255, 0.5) !important; }
    .app-chip {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(99, 102, 241, 0.2); border: 1px solid rgba(99, 102, 241, 0.4);
      color: #c7d2fe; border-radius: 999px; padding: 6px 16px; font-size: 0.85rem; font-weight: 500;
      max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .dest-note {
      background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px; padding: 10px 12px; font-size: 0.75rem; color: rgba(255, 255, 255, 0.55);
      word-break: break-all;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-5 col-lg-4">
        <div class="glass-card p-4">
          <div class="text-center mb-4">
            <div style="font-size:48px;margin-bottom:10px;">🔐</div>
            <h3 class="text-white mb-2">Sign in to continue</h3>
            <% if (app_name) { %>
              <span class="app-chip"><i class="bi bi-app-indicator"></i> <%= app_name %></span>
            <% } %>
          </div>

          <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>

          <form method="POST" action="/auth/login" autocomplete="off">
            <input type="hidden" name="client_id" value="<%= client_id %>">
            <div class="mb-3">
              <label class="form-label text-white-50 small mb-1">USERNAME</label>
              <input type="text" name="username" class="form-control" required autofocus autocomplete="username">
            </div>
            <div class="mb-4">
              <label class="form-label text-white-50 small mb-1">PASSWORD</label>
              <input type="password" name="password" class="form-control" required autocomplete="current-password">
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2">Sign in &amp; continue</button>
          </form>

          <div class="mt-3">
            <div class="text-muted text-center small mb-2">You will be returned to</div>
            <div class="dest-note text-center"><%= redirect_uri %></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
